<% // Set optional variables 
const message = locals.message || ""; 
const entries = locals.entries || {}; 
const errors = locals.errors || [];
%>

<!-- Hero Start -->
<div class="container-xxl py-5 bg-dark hero-header mb-5">
  <div class="container text-center my-5 pt-5 pb-4">
    <h1 class="display-3 text-white mb-3 animated slideInDown">Contact Us</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb justify-content-center text-uppercase">
        <li class="breadcrumb-item"><a href="#">Home</a></li>
        <li class="breadcrumb-item text-white active" aria-current="page">Contact</li>
      </ol>
    </nav>
  </div>
</div>
<!-- Hero End -->
<!-- Navbar & Hero End -->

<!-- Contact Start -->
<div class="container-xxl py-5">
  <div class="container">
    <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
      <h5 class="section-title ff-secondary text-center text-primary fw-normal">Contact Us</h5>
      <h1 class="mb-5">Contact For Any Query</h1>
    </div>
    <div class="row g-4">
      <div class="col-12">
        <div class="row gy-4">
          <div class="col-md-4">
            <h5 class="section-title ff-secondary fw-normal text-start text-primary">Booking</h5>
            <p><i class="fa fa-envelope-open text-primary me-2"></i>book@example.com</p>
          </div>
          <div class="col-md-4">
            <h5 class="section-title ff-secondary fw-normal text-start text-primary">General</h5>
            <p><i class="fa fa-envelope-open text-primary me-2"></i>info@example.com</p>
          </div>
          <div class="col-md-4">
            <h5 class="section-title ff-secondary fw-normal text-start text-primary">Technical</h5>
            <p><i class="fa fa-envelope-open text-primary me-2"></i>tech@example.com</p>
          </div>
        </div>
      </div>
      <div class="col-md-6 wow fadeIn" data-wow-delay="0.1s">
        <iframe
          class="position-relative rounded w-100 h-100"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3001156.4288297426!2d-78.01371936852176!3d42.72876761954724!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4ccc4bf0f123a5a9%3A0xddcfc6c1de189567!2sNew%20York%2C%20USA!5e0!3m2!1sen!2sbd!4v1603794290143!5m2!1sen!2sbd"
          frameborder="0"
          style="min-height: 350px; border: 0"
          allowfullscreen=""
          aria-hidden="false"
          tabindex="0"
        ></iframe>
      </div>
      <div class="col-md-6">
        <div class="wow fadeInUp" data-wow-delay="0.2s">
          <p class="<%= errors.length > 0 ? 'text-danger' : 'text-success' %>"><%= message %></p>
          <form action="/contact" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="row g-3">
              <div class="col-md-6">
                <div class="form-floating">
                  <% let fieldErrors = errors.filter(error => error.path === "name"); %>
                  <input type="text" class="form-control <%= fieldErrors.length > 0 && 'is-invalid' %>" id="name" name="name" placeholder="Your Name" value="<%= entries.name %>" />
                  <label for="name">Your Name</label>
                  <div class="invalid-feedback">
                    <%  fieldErrors.forEach((fieldError) => { %>
                        <p><%= fieldError.message %></p>
                    <% }) %>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-floating">
                  <% fieldErrors = errors.filter(error => error.path === "email"); %>
                  <input type="text" class="form-control <%= fieldErrors.length > 0 && 'is-invalid' %>" id="email" name="email" placeholder="Your Email" value="<%= entries.email %>" />
                  <label for="email">Your Email</label>
                  <div class="invalid-feedback">
                    <%  fieldErrors.forEach((fieldError) => { %>
                        <p><%= fieldError.message %></p>
                    <% }) %>
                  </div>
                </div>
              </div>
              <div class="col-12">
                <div class="form-floating">
                  <% fieldErrors = errors.filter(error => error.path === "subject"); %>
                  <input type="text" class="form-control <%= fieldErrors.length > 0 && 'is-invalid' %>" id="subject" name="subject" placeholder="Subject" value="<%= entries.subject %>" />
                  <label for="subject">Subject</label>
                  <div class="invalid-feedback">
                    <%  fieldErrors.forEach((fieldError) => { %>
                        <p><%= fieldError.message %></p>
                    <% }) %>
                  </div>
                </div>
              </div>
              <div class="col-12">
                <div class="form-floating">
                  <% fieldErrors = errors.filter(error => error.path === "message"); %>
                  <textarea class="form-control <%= fieldErrors.length > 0 && 'is-invalid' %>" placeholder="Leave a message here" name="message" id="message" style="height: 150px"><%= entries.message %></textarea>
                  <label for="message">Message</label>
                  <div class="invalid-feedback">
                    <%  fieldErrors.forEach((fieldError) => { %>
                        <p><%= fieldError.message %></p>
                    <% }) %>
                  </div>
                </div>
              </div>
              <div class="col-12">
                <button class="btn btn-primary w-100 py-3" type="submit">Send Message</button>
              </div>
            </div>
          </form>
          
         
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Contact End -->
